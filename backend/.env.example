# Flags API Environment Keys. These are public, non-secret SDK keys, not
# Organisation API tokens or server-side SDK tokens. FlagPilot keeps them in
# backend/.env to centralize environment routing; never put admin tokens here.
# Configure only the environments you want available in the FlagPilot selector.
FLAGSMITH_DEVELOPMENT_ENVIRONMENT_KEY=
FLAGSMITH_STAGING_ENVIRONMENT_KEY=
FLAGSMITH_PRODUCTION_ENVIRONMENT_KEY=

# Optional compatibility setting for one environment. The key is assigned to
# FLAGSMITH_ENVIRONMENT_NAME only when its matching per-environment key is empty.
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_ENVIRONMENT_NAME=Production

# Flagsmith Cloud default. For self-hosted, use the Flagsmith API v1 base URL.
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# Local listener defaults to loopback. Set HOST=0.0.0.0 for a hosted service.
HOST=127.0.0.1
PORT=3002
# Number of trusted reverse-proxy hops. Keep 0 locally; Render uses 1 for its known ingress proxy.
TRUST_PROXY_HOPS=0

# Exact browser origins allowed to call the API. Add the deployed frontend origin when hosting.
FLAGPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
